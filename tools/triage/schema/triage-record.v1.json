{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "triage-record/v1",
  "title": "Triage Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "triage_id", "source_file", "triaged_at", "intent", "category",
    "priority", "target", "title", "task", "acceptance", "context_refs",
    "related_reqkit_id", "possible_duplicate_of", "needs_clarification",
    "questions", "flags", "confidence"
  ],
  "properties": {
    "schema": { "const": "triage-record/v1" },
    "triage_id": { "type": "string", "pattern": "^trg-[A-Za-z0-9._-]+-[0-9]{2}$" },
    "source_file": { "type": "string", "minLength": 1 },
    "triaged_at": { "type": "string", "format": "date-time" },
    "intent": { "enum": ["new", "update", "cancel", "question"] },
    "category": { "enum": ["scan", "fix", "review", "config", "investigate", "other"] },
    "priority": { "enum": ["urgent", "normal", "low"] },
    "target": { "type": ["string", "null"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "task": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "acceptance": { "type": "array", "items": { "type": "string" } },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file"],
        "properties": {
          "file": { "type": "string" },
          "lines": { "type": "string", "pattern": "^[0-9]+(-[0-9]+)?$" }
        }
      }
    },
    "related_reqkit_id": { "type": ["string", "null"] },
    "possible_duplicate_of": { "type": "array", "items": { "type": "string" } },
    "needs_clarification": { "type": "boolean" },
    "questions": { "type": "array", "items": { "type": "string" } },
    "flags": { "type": "array", "items": { "type": "string" } },
    "confidence": { "enum": ["high", "medium", "low"] }
  },
  "allOf": [
    {
      "if": { "properties": { "needs_clarification": { "const": true } } },
      "then": { "properties": { "questions": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "intent": { "enum": ["update", "cancel"] } } },
      "then": { "properties": { "related_reqkit_id": { "type": "string" } } }
    }
  ]
}
