#!/usr/bin/env bash
# Post-commit (TASK-149, REQ-0155). Never blocks or fails the commit.
# 1. Advisory checks on HEAD (tools/post_commit_check.py). Off: POST_COMMIT_CHECK=0
# 2. Auto-push (idea of tmp/post-commit, RAW-00373): push each commit on a non-main branch to origin in the
#    background, so a local loss costs at most the last commit. main/master are never pushed here.
#    Off: AUTO_PUSH=0 git commit ...   Log: $(git rev-parse --git-dir)/autopush.log
# Enable once per clone: git config core.hooksPath .githooks
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
if [ -f "$root/tools/post_commit_check.py" ]; then
  python3 -I "$root/tools/post_commit_check.py" --root "$root" || true
fi

# 3. Auto backup (TASK-150, REQ-0156): git cannot restore the ignored plans/ and input/; when they changed after
#    the newest ~/exam-harness-backup archive, run `exam backup` in the background. Off: AUTO_BACKUP=0
#    Log: $(git rev-parse --git-dir)/autobackup.log
if [ "${AUTO_BACKUP:-1}" = 1 ] && [ -f "$root/scripts/exam.py" ] \
   && python3 -I "$root/tools/post_commit_check.py" --root "$root" --stale-backup; then
  blog="$(git rev-parse --git-dir)/autobackup.log"
  (
    cd "$root" && python3 -I scripts/exam.py backup >>"$blog" 2>&1 \
      || echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) BACKUP FAILED (run: python3 -I scripts/exam.py backup)" >>"$blog"
  ) </dev/null >/dev/null 2>&1 &
fi

[ "${AUTO_PUSH:-1}" = 1 ] || exit 0
b="$(git symbolic-ref --short -q HEAD)" || exit 0
case "$b" in main|master) exit 0 ;; esac
git remote get-url origin >/dev/null 2>&1 || exit 0
log="$(git rev-parse --git-dir)/autopush.log"
sha="$(git rev-parse --short HEAD)"
to=""
command -v timeout >/dev/null 2>&1 && to="timeout 120"
(
  if $to git push -q origin "HEAD:refs/heads/$b" >>"$log" 2>&1; then
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) pushed $b $sha" >>"$log"
  else
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) PUSH FAILED $b $sha (run: git push origin $b)" >>"$log"
  fi
) </dev/null >/dev/null 2>&1 &
exit 0
